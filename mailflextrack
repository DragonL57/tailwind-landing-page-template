    <title>VMG_Report_A4_4_Rows_Style</title>
    <style>
        :root {
            --brand-crimson: #BE202F;
            --brand-gold: #B6914C;
            --brand-navy: #232d3b;
            --bg-light-red: #fff5f5;
            --bg-light-gold: #fdfaf3;
            --bg-light-navy: #f0f4f8; /* Màu xanh Navy nhạt cho hàng trình độ */
            --bg-light-gray: #f9f9f9;
        }

        @page { size: A4; margin: 0; }
        body { margin: 0; padding: 0; font-family: 'Segoe UI', Arial, sans-serif; background-color: #ffffff; -webkit-print-color-adjust: exact; }

        .a4-container {
            width: 210mm;
            height: 297mm;
            margin: 0 auto;
            box-sizing: border-box;
            padding: 15mm;
            position: relative;
        }

        /* Header VMG */
       /* Header VMG - Thiết kế lại để chống tràn */
.header {
    background-color: var(--brand-crimson);
    padding: 25px 0; /* Chỉ padding trên dưới */
    text-align: center;
    border-bottom: 5px solid var(--brand-gold);
    margin: -15mm -15mm 30px -15mm;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: calc(100% + 30mm); /* Đảm bảo phủ kín chiều ngang giấy */
}

.logo-header {
    height: 60px;        /* Chiều cao chuẩn */
    width: auto;         /* Rộng tự động */
    max-width: 85%;      /* Không bao giờ được rộng quá 85% trang giấy */
    display: block;
    margin: 0 auto 10px auto; 
    object-fit: contain; /* Giữ nguyên tỉ lệ logo */
    /* Dòng dưới đây là "phép thuật" để bỏ qua khoảng trắng thừa của ảnh */
    filter: drop-shadow(0 0 0 transparent); 
}

.header h1 { 
    color: #ffffff; 
    margin: 0; 
    font-size: 20px; 
    text-transform: uppercase; 
    letter-spacing: 2px;
    width: 100%;
}
/* SECTION TITLE - FIX THANH VÀNG CHUẨN */
        .section-title {
            display: flex;
            align-items: center; /* Căn thanh vàng thẳng hàng chính giữa chữ */
            margin-top: 40px;    /* Tăng khoảng cách phía trên để không dính vào header */
            margin-bottom: 20px;
            width: 100%;         /* Đảm bảo thanh vàng chạy hết chiều ngang */
        }

        .section-title h2 { 
            color: var(--brand-crimson); 
            font-size: 18px; 
            margin: 0; 
            text-transform: uppercase; 
            padding-right: 15px; /* Khoảng cách giữa chữ và thanh vàng */
            white-space: nowrap; /* Không cho chữ bị xuống dòng */
            line-height: 1;
            font-weight: 800;
        }

        .section-title .line { 
            flex-grow: 1; 
            height: 1.5px; /* Độ dày thanh vàng mỏng và sắc nét */
            background-color: var(--brand-gold); 
        }

        /* BẢNG THÔNG TIN KIỂU PHÂN CẤP 4 HÀNG */
        .info-table-modern {
            width: 100%;
            border: 2px solid var(--brand-gold);
            border-radius: 15px;
            overflow: hidden;
            border-collapse: collapse;
        }

        .info-row { display: flex; border-bottom: 1px solid #eee; }
        .info-row:last-child { border-bottom: none; }

        /* Cột trái - Nhãn (Label) */
        .info-label {
            width: 30%;
            padding: 18px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            border-right: 1px solid #eee;
        }

        .info-label b { font-size: 12px; text-transform: uppercase; letter-spacing: 1px; }

        /* Cột phải - Nội dung (Value) */
        .info-content {
            width: 70%;
            padding: 18px 25px;
            display: flex;
            align-items: center;
        }

        .info-content .value { font-size: 15px; font-weight: 600; color: #333; }

        /* PHỐI MÀU 4 HÀNG */
        /* Hàng 1: Đỏ (Học viên) */
        .row-student .info-label { background-color: var(--bg-light-red); color: var(--brand-crimson); }
        .row-student .value { color: var(--brand-crimson); font-size: 18px; text-transform: uppercase; }

        /* Hàng 2: Vàng (Ngành nghề) */
        .row-industry .info-label { background-color: var(--bg-light-gold); color: var(--brand-gold); }

        /* Hàng 3: Xanh Navy (Trình độ mong muốn) */
        .row-level .info-label { background-color: var(--bg-light-navy); color: var(--brand-navy); }
        .row-level .value { color: var(--brand-gold); font-weight: 800; font-size: 17px; }

        /* Hàng 4: Xám (Mục tiêu học tập) */
        .row-goal .info-label { background-color: var(--bg-light-gray); color: #555; }

        .footer {
            position: absolute;
            bottom: 15mm;
            width: 180mm;
            text-align: center;
            border-top: 1px solid #eee;
            padding-top: 15px;
            color: #888;
            font-size: 11px;
        }
    </style>
</head>
