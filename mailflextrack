/* --- THANH ROADMAP HÌNH CHỮ NHẬT MỚI --- */
.path-arrow-layer {
    position: absolute;
    bottom: 30px; /* Vị trí cách đáy khung mapping */
    left: 25px; 
    right: 25px;
    height: 45px;
}

.dynamic-arrow-bar {
    position: absolute;
    height: 40px;
    /* Hiệu ứng màu gradient từ Đỏ sang Vàng */
    background: linear-gradient(to right, #BE202F 0%, #B6914C 100%);
    border-radius: 6px;
    display: flex; 
    align-items: center; 
    justify-content: space-between;
    padding: 0 15px; 
    color: white;
    box-shadow: 0 4px 10px rgba(0,0,0,0.15);
    box-sizing: border-box;
    z-index: 10;
}

/* Mũi tên nhọn ở đầu thanh bar */
.dynamic-arrow-bar::after {
    content: ''; 
    position: absolute; 
    right: -15px;
    border-top: 20px solid transparent; 
    border-bottom: 20px solid transparent;
    border-left: 18px solid #B6914C;
}

